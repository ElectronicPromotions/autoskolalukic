{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "sajt",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(autoskolalukic|autoskoladrivepro)/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/((autoskolalukic|autoskoladrivepro)/)?assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|ico|svg|jpg|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(autoskolalukic|autoskoladrivepro)/podaci/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/autoskolalukic/cjenovnik/",
      "destination": "/autoskolalukic/",
      "permanent": true
    },
    {
      "source": "/autoskolalukic/predavanja/",
      "destination": "/autoskolalukic/",
      "permanent": true
    },
    {
      "source": "/lukic/",
      "destination": "/autoskolalukic/",
      "permanent": true
    },
    {
      "source": "/drivepro/",
      "destination": "/autoskoladrivepro/",
      "permanent": true
    },
    {
      "source": "/upis/",
      "destination": "/autoskolalukic/upis/",
      "permanent": true
    },
    {
      "source": "/novosti/",
      "destination": "/autoskolalukic/novosti/",
      "permanent": true
    },
    {
      "source": "/kontakt/",
      "destination": "/autoskolalukic/kontakt/",
      "permanent": true
    },
    {
      "source": "/instruktori/",
      "destination": "/autoskolalukic/instruktori/",
      "permanent": true
    },
    {
      "source": "/o-nama/",
      "destination": "/autoskolalukic/o-nama/",
      "permanent": true
    },
    {
      "source": "/kategorije/",
      "destination": "/autoskolalukic/kategorije/",
      "permanent": true
    },
    {
      "source": "/pitanja/",
      "destination": "/autoskolalukic/pitanja/",
      "permanent": true
    },
    {
      "source": "/galerija/",
      "destination": "/autoskolalukic/galerija/",
      "permanent": true
    },
    {
      "source": "/teorijska-nastava/",
      "destination": "/autoskolalukic/teorijska-nastava/",
      "permanent": true
    },
    {
      "source": "/a-kategorija/",
      "destination": "/autoskolalukic/a-kategorija/",
      "permanent": true
    },
    {
      "source": "/b-kategorija/",
      "destination": "/autoskolalukic/b-kategorija/",
      "permanent": true
    },
    {
      "source": "/c-kategorija/",
      "destination": "/autoskolalukic/c-kategorija/",
      "permanent": true
    },
    {
      "source": "/ce-kategorija/",
      "destination": "/autoskolalukic/ce-kategorija/",
      "permanent": true
    },
    {
      "source": "/d-kategorija/",
      "destination": "/autoskolalukic/d-kategorija/",
      "permanent": true
    },
    {
      "source": "/cjenovnik/",
      "destination": "/autoskolalukic/",
      "permanent": true
    },
    {
      "source": "/predavanja/",
      "destination": "/autoskolalukic/",
      "permanent": true
    }
  ]
}